{
  "expo": {
    "name": "ShiftBuddy",
    "slug": "shiftbuddy",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "scheme": "shiftbuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.shiftbuddy.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ShiftBuddy uses your location to calculate travel time to your shifts.",
        "NSCameraUsageDescription": "ShiftBuddy uses the camera to take a photo of your work schedule and read your shifts from it.",
        "NSPhotoLibraryUsageDescription": "ShiftBuddy reads your shifts from a schedule photo or screenshot you choose.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shiftbuddy.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#0F172A",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "ShiftBuddy uses the camera to take a photo of your work schedule and read your shifts from it.",
          "photosPermission": "ShiftBuddy reads your shifts from a schedule photo or screenshot you choose.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ShiftBuddy uses your location to calculate travel time to your shifts."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a8fe8d4-96df-47dd-ad3c-7b288c7d9d5a"
      }
    }
  }
}
